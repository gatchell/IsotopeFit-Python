           <property name="text">
            <string>Save as .ifm…</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="useButton">
           <property name="text">
            <string>Use in project</string>
           </property>
           <property name="toolTip">
            <string>Replace the project's molecules with these</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="appendButton">
           <property name="text">
            <string>Add to project</string>
           </property>
           <property name="toolTip">
            <string>Add these to the project's molecules (names already there are skipped)</string>
           </property>
          </widget>
         </item>
        </layout>
       </item>
      </layout>
     </widget>
    </widget>
